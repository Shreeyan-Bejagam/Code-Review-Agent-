{
  "name": "AI Code Reviewer",
  "url": "https://example.com",
  "hook_attributes": {
    "url": "https://example.com/webhook"
  },
  "redirect_url": "https://example.com/setup",
  "description": "Production-grade AI code review bot for pull requests.",
  "public": false,
  "default_events": [
    "pull_request"
  ],
  "default_permissions": {
    "pull_requests": "write",
    "contents": "read",
    "metadata": "read"
  }
}

